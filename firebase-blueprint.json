{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user profile and authorized role assignment.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string", "enum": ["Rawalpindi", "Islamabad"] },
        "area": { "type": "string" },
        "defaultAddress": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "collector", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "city", "role", "status", "createdAt", "updatedAt"]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Customer account metadata and booking counters.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string", "enum": ["Rawalpindi", "Islamabad"] },
        "area": { "type": "string" },
        "defaultAddress": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "totalBookings": { "type": "integer" },
        "totalCompletedKg": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "name", "city", "area", "status", "createdAt", "updatedAt"]
    },
    "CollectorProfile": {
      "title": "CollectorProfile",
      "description": "Local kabari shop, dealer, or independent collector registration and approval record.",
      "type": "object",
      "properties": {
        "collectorId": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "shopOrBusinessName": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string", "enum": ["Rawalpindi", "Islamabad"] },
        "serviceAreas": { "type": "array", "description": "Matched service areas up to 20" },
        "acceptedCategories": { "type": "array", "description": "Handled scrap category IDs up to 12" },
        "vehicleType": { "type": "string" },
        "address": { "type": "string" },
        "cnicLast4": { "type": "string" },
        "availabilityOnline": { "type": "boolean" },
        "approvalStatus": { "type": "string", "enum": ["pending_approval", "approved", "rejected", "suspended"] },
        "rejectionReason": { "type": "string" },
        "radiusKm": { "type": "number" },
        "completedPickupsCount": { "type": "integer" },
        "totalEarningsPkr": { "type": "number" },
        "commissionDuePkr": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["collectorId", "userId", "fullName", "shopOrBusinessName", "phone", "city", "serviceAreas", "acceptedCategories", "vehicleType", "availabilityOnline", "approvalStatus", "radiusKm", "createdAt", "updatedAt"]
    },
    "ScrapCategoryDoc": {
      "title": "ScrapCategoryDoc",
      "description": "Scrap material category managed by Collection Hub admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "urduName": { "type": "string" },
        "description": { "type": "string" },
        "unitOptions": { "type": "array" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "urduName", "description", "unitOptions", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "ScrapPriceDoc": {
      "title": "ScrapPriceDoc",
      "description": "Dynamic indicative estimated price range per category managed in Admin Portal.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "unit": { "type": "string", "enum": ["KG", "Piece", "Bag", "Bulk"] },
        "minEstimatedPkr": { "type": "number" },
        "maxEstimatedPkr": { "type": "number" },
        "isIndicative": { "type": "boolean" },
        "city": { "type": "string" },
        "isActive": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["categoryId", "categoryName", "unit", "minEstimatedPkr", "maxEstimatedPkr", "isIndicative", "city", "isActive", "updatedBy", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Private customer pickup booking with full address and transaction lifecycle state.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "city": { "type": "string", "enum": ["Rawalpindi", "Islamabad"] },
        "area": { "type": "string" },
        "fullAddress": { "type": "string" },
        "categories": { "type": "array" },
        "itemsSummary": { "type": "string" },
        "unitType": { "type": "string", "enum": ["KG", "Piece", "Bag", "Bulk"] },
        "estimatedWeightKg": { "type": "number" },
        "estimatedMinPkr": { "type": "number" },
        "estimatedMaxPkr": { "type": "number" },
        "preferredDate": { "type": "string" },
        "preferredTimeSlot": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Easypaisa", "Bank Transfer"] },
        "photoUri": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["searching", "assigned", "on_the_way", "arrived", "weight_price_confirmation", "completed", "cancelled"] },
        "otpCode": { "type": "string" },
        "otpVerified": { "type": "boolean" },
        "verifiedWeightKg": { "type": "number" },
        "finalAmountPkr": { "type": "number" },
        "customerConfirmed": { "type": "boolean" },
        "paymentConfirmedByCustomer": { "type": "boolean" },
        "assignedCollectorId": { "type": "string" },
        "assignedCollectorName": { "type": "string" },
        "assignedCollectorPhone": { "type": "string" },
        "collectorNotes": { "type": "string" },
        "rating": { "type": "integer" },
        "review": { "type": "string" },
        "cancellationReason": { "type": "string" },
        "matchingRadiusKm": { "type": "number" },
        "assignedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "customerName", "customerPhone", "city", "area", "fullAddress", "categories", "itemsSummary", "unitType", "estimatedWeightKg", "estimatedMinPkr", "estimatedMaxPkr", "preferredDate", "preferredTimeSlot", "paymentMethod", "status", "otpCode", "otpVerified", "verifiedWeightKg", "finalAmountPkr", "customerConfirmed", "paymentConfirmedByCustomer", "matchingRadiusKm", "createdAt", "updatedAt"]
    },
    "PickupPoolItem": {
      "title": "PickupPoolItem",
      "description": "Sanitized open pickup pool entry hiding exact address/phone until atomic collector lock.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "customerId": { "type": "string" },
        "city": { "type": "string", "enum": ["Rawalpindi", "Islamabad"] },
        "area": { "type": "string" },
        "categories": { "type": "array" },
        "itemsSummary": { "type": "string" },
        "unitType": { "type": "string", "enum": ["KG", "Piece", "Bag", "Bulk"] },
        "estimatedQuantityLabel": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTimeSlot": { "type": "string" },
        "status": { "type": "string", "enum": ["searching", "locked", "cancelled"] },
        "assignedCollectorId": { "type": "string" },
        "radiusKm": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "customerId", "city", "area", "categories", "itemsSummary", "unitType", "estimatedQuantityLabel", "preferredDate", "preferredTimeSlot", "status", "radiusKm", "createdAt", "updatedAt"]
    },
    "PaymentMethodConfig": {
      "title": "PaymentMethodConfig",
      "description": "Admin-managed manual payment method instructions (Cash, Bank Transfer, Easypaisa).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "enum": ["Cash", "Bank Transfer", "Easypaisa"] },
        "accountTitle": { "type": "string" },
        "accountNumberOrNote": { "type": "string" },
        "instructions": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "accountTitle", "accountNumberOrNote", "instructions", "isActive", "createdAt", "updatedAt"]
    },
    "ManualPayment": {
      "title": "ManualPayment",
      "description": "Manual payment confirmation and admin verification record.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "customerId": { "type": "string" },
        "collectorId": { "type": "string" },
        "method": { "type": "string", "enum": ["Cash", "Bank Transfer", "Easypaisa"] },
        "amountPkr": { "type": "number" },
        "submittedByUid": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "proofNote": { "type": "string" },
        "customerConfirmed": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["pending_verification", "verified", "rejected"] },
        "verifiedByAdminUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "customerId", "collectorId", "method", "amountPkr", "submittedByUid", "customerConfirmed", "verificationStatus", "createdAt", "updatedAt"]
    },
    "CommissionRecord": {
      "title": "CommissionRecord",
      "description": "Per-booking commission record preventing duplicate computation via deterministic booking ID key.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "collectorId": { "type": "string" },
        "collectorName": { "type": "string" },
        "ruleType": { "type": "string", "enum": ["percentage", "fixed", "category"] },
        "rateApplied": { "type": "number" },
        "bookingAmountPkr": { "type": "number" },
        "commissionAmountPkr": { "type": "number" },
        "status": { "type": "string", "enum": ["unpaid", "settled"] },
        "settlementId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "collectorId", "collectorName", "ruleType", "rateApplied", "bookingAmountPkr", "commissionAmountPkr", "status", "createdAt", "updatedAt"]
    },
    "CommissionSettlement": {
      "title": "CommissionSettlement",
      "description": "Immutable weekly or monthly manual collector commission settlement ledger.",
      "type": "object",
      "properties": {
        "collectorId": { "type": "string" },
        "collectorName": { "type": "string" },
        "periodLabel": { "type": "string" },
        "totalAmountPkr": { "type": "number" },
        "commissionIds": { "type": "array" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Bank Transfer", "Easypaisa"] },
        "referenceNote": { "type": "string" },
        "recordedByAdminUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["collectorId", "collectorName", "periodLabel", "totalAmountPkr", "commissionIds", "paymentMethod", "referenceNote", "recordedByAdminUid", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification for booking, approval, or payment events.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "referenceId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "title", "body", "type", "referenceId", "read", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Customer or collector complaint / support case.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["customer", "collector"] },
        "bookingId": { "type": "string" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_review", "resolved", "closed"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userRole", "category", "subject", "description", "status", "createdAt", "updatedAt"]
    },
    "ServiceArea": {
      "title": "ServiceArea",
      "description": "Rawalpindi and Islamabad operational area and configurable matching radius.",
      "type": "object",
      "properties": {
        "city": { "type": "string", "enum": ["Rawalpindi", "Islamabad"] },
        "areaName": { "type": "string" },
        "matchingRadiusKm": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["city", "areaName", "matchingRadiusKm", "isActive", "createdAt", "updatedAt"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Platform-wide configuration for matching radius, commissions, and contact details.",
      "type": "object",
      "properties": {
        "defaultMatchingRadiusKm": { "type": "number" },
        "commissionRuleType": { "type": "string", "enum": ["percentage", "fixed", "category"] },
        "defaultCommissionPercent": { "type": "number" },
        "defaultFixedCommissionPkr": { "type": "number" },
        "supportPhone": { "type": "string" },
        "supportEmail": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["defaultMatchingRadiusKm", "commissionRuleType", "defaultCommissionPercent", "defaultFixedCommissionPkr", "supportPhone", "supportEmail", "updatedBy", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational and administrative audit trail.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorRole", "action", "entity", "entityId", "details", "createdAt"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Verified admin authorization record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User accounts isolated by UID"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerProfile" },
      "description": "Customer profiles isolated by customer UID"
    },
    "/collectors/{collectorId}": {
      "schema": { "$ref": "#/entities/CollectorProfile" },
      "description": "Collector profiles and admin approval status"
    },
    "/scrap_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/ScrapCategoryDoc" },
      "description": "Admin-managed scrap material categories"
    },
    "/scrap_prices/{priceId}": {
      "schema": { "$ref": "#/entities/ScrapPriceDoc" },
      "description": "Admin-managed indicative estimated scrap price ranges"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer pickup bookings with full address restricted to owner, winner collector, and admin"
    },
    "/pickup_pool/{bookingId}": {
      "schema": { "$ref": "#/entities/PickupPoolItem" },
      "description": "Sanitized open pickup pool with approximate area only until atomic collector lock"
    },
    "/payment_methods/{methodId}": {
      "schema": { "$ref": "#/entities/PaymentMethodConfig" },
      "description": "Manual payment method settings managed by admin"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/ManualPayment" },
      "description": "Manual payment confirmations and admin verification status"
    },
    "/commissions/{commissionId}": {
      "schema": { "$ref": "#/entities/CommissionRecord" },
      "description": "Duplicate-safe commission records per completed booking"
    },
    "/commission_settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/CommissionSettlement" },
      "description": "Immutable weekly/monthly commission settlement ledger"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User-scoped in-app notifications"
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Customer and collector complaints managed with admin"
    },
    "/service_areas/{areaId}": {
      "schema": { "$ref": "#/entities/ServiceArea" },
      "description": "Rawalpindi and Islamabad service areas and configurable matching radius"
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Platform configuration settings managed by admin"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit logs"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Admin UID authorization documents"
    }
  }
}
